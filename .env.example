# Copia este fichero a .env (ignorado por git) y rellena solo lo que necesites.
# Nunca subas claves al repositorio. No existe ninguna variable para credenciales de casas de
# apuestas: el sistema nunca las usa.

# Clave de The Odds API. Obligatoria para `tipster scan` en vivo; no hace falta con --offline.
ODDS_API_KEY=

# Base de datos SQLite y respuestas crudas del proveedor (ambas bajo data/, ignorado por git).
TIPSTER_DB_PATH=data/tipster.sqlite
TIPSTER_RAW_DIR=data/raw

# Caché: una petición idéntica dentro de este plazo reutiliza la respuesta y gasta 0 créditos.
TIPSTER_CACHE_TTL_SECONDS=60
# Presupuesto máximo de créditos de The Odds API por ejecución.
TIPSTER_MAX_CREDITS_PER_RUN=30
# Intervalo mínimo entre peticiones (provisional: el límite real del proveedor no está verificado).
TIPSTER_MIN_REQUEST_INTERVAL_S=1.0

# Listas separadas por comas. Valores válidos: ver src/tipster/domain/.
TIPSTER_COMPETITIONS=laliga,segunda,premier,serie_a,bundesliga,ligue_1,champions
TIPSTER_MARKETS=1x2,ou_2.5
TIPSTER_BOOKMAKERS=pinnacle,betfair_ex_no_es,888sport_no_es,williamhill_no_es,marathonbet_no_es,winamax_fr,winamax_de,betfair_sb_uk
TIPSTER_REFERENCE_ORDER=pinnacle,betfair_ex_no_es

# multiplicativo | aditivo | power | shin (provisional; se elegirá con datos de validación).
TIPSTER_DEVIG_METHOD=multiplicativo
TIPSTER_EV_MIN=0.03
TIPSTER_ERROR_MARGIN=0.15
TIPSTER_MAX_QUOTE_AGE_MINUTES=10
TIPSTER_MAX_REFERENCE_AGE_MINUTES=10

# Solo para mostrar horas; en la base de datos todo se guarda en UTC.
TIPSTER_TIMEZONE=Europe/Madrid
