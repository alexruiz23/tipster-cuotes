<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tipster.settle</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__ROOT__/scripts/settle.sh</string></array>
  <!-- launchd usa la hora local: 04:00 CET = 03:00 UTC (en verano, 02:00 UTC) -->
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardErrorPath</key><string>__ROOT__/data/logs/launchd-settle.err</string>
</dict>
</plist>
